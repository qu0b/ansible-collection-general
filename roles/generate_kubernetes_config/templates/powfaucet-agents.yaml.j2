# {{ ansible_managed }}

powfaucet:
  fullnameOverride: powfaucet-agents

  image:
    repository: {{ (default_tooling_images.powfaucet_agents | default(default_tooling_images.powfaucet)).split(':') | first }}
    tag: {{ (default_tooling_images.powfaucet_agents | default(default_tooling_images.powfaucet)).split(':') | last}}
    pullPolicy: IfNotPresent

  resources:
    requests:
      cpu: 200m
      memory: 500Mi
    limits:
      cpu: 400m
      memory: 1Gi

  ingress:
    enabled: true
    className: ingress-nginx-public
    annotations:
      nginx.ingress.kubernetes.io/proxy-body-size: "0"
    hosts:
      - host: faucet-agents.{{ network_subdomain }}
        paths:
          - path: /
            pathType: Prefix

  httpProxyCount: 2

  faucetTitle: "{{ ethereum_network_name }} Agent Faucet"
  faucetPrivkey: "<path:/secrets/services/services.enc.yaml#ethereum | jsonPath {.testnets.{{ devnet_name }}-devnets.faucet_agents_private_key}>"
  faucetRpcUrl: "https://<path:/secrets/services/services.enc.yaml#ethereum | jsonPath {.testnets.{{ devnet_name }}-devnets.node_ingress.combined}>@{{ ethereum_node_rpc_prefix }}{{ primary_bootnode }}.{{ network_server_subdomain }}"
{# Multi-RPC endpoint list. If the operator set gen_kubernetes_config_powfaucet_rpc_endpoints, that wins.
   Otherwise auto-generate from inventory: tooling/bootnode first, then ethereum_node clients sorted
   by reverse hostname so consecutive entries cover different client pair types. Total capped at 20. #}
{% if gen_kubernetes_config_powfaucet_rpc_endpoints %}
  faucetRpcEndpoints:
{% for ep in gen_kubernetes_config_powfaucet_rpc_endpoints %}
    - url: "{{ ep.url }}"
{% if ep.name is defined %}      name: "{{ ep.name }}"
{% endif %}      priority: {{ ep.priority | default(1) }}
      metered: {{ ep.metered | default(false) }}
{% endfor %}
{% else %}
{%   set _client_pairs = [] %}
{%   for host in (groups['ethereum_node'] | default([])) %}
{%     set _hostname = hostvars[host]['inventory_hostname'] %}
{%     set _ = _client_pairs.append([_hostname[::-1], _hostname]) %}
{%   endfor %}
{%   set _clients_sorted = (_client_pairs | sort) %}
  faucetRpcEndpoints:
    - url: "https://<path:/secrets/services/services.enc.yaml#ethereum | jsonPath {.testnets.{{ devnet_name }}-devnets.node_ingress.combined}>@{{ ethereum_node_rpc_prefix }}{{ primary_bootnode }}.{{ network_server_subdomain }}"
      name: "{{ primary_bootnode }}"
      priority: 10
{%   for pair in _clients_sorted[:19] %}
    - url: "https://<path:/secrets/services/services.enc.yaml#ethereum | jsonPath {.testnets.{{ devnet_name }}-devnets.node_ingress.combined}>@{{ ethereum_node_rpc_prefix }}{{ pair[1] }}.{{ network_server_subdomain }}"
      name: "{{ pair[1] }}"
      priority: 5
{%   endfor %}
{% endif %}
  faucetExplorerLink: "{{ gen_kubernetes_config_dora_frontend_explorer_link }}/tx/{txid}"
  faucetTxGasLimit: 100000

  # Captcha disabled — agents authenticate via PoW, not captcha.
  faucetCaptchaEnabled: false

  # Authenticatoor disabled — dedicated agent faucet; no browser login.
  faucetAuthenticatoorEnabled: false

  faucetRecurringLimitsAmountWei: 5000000000000000000000 # 5000 ETH
  faucetMaxDropWei: 500000000000000000000 # 500 ETH
  faucetPowEnabled: true
  faucetPowRewardPerHash: 1000000000000000000 # 1 ETH
  faucetPowDifficulty: 10

  extraEnv:
    - name: FAUCET_ETH_REST_WALLET_KEY
      value: "<path:/secrets/services/services.enc.yaml#ethereum | jsonPath {.testnets.{{ devnet_name }}-devnets.faucet_agents_rest_private_key}>"
